# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./book_management.db
DATABASE_ECHO=false

# API Configuration
API_V1_STR=/api/v1
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Llama3 / OpenRouter Configuration
OPENROUTER_API_KEY=sk-or-v1-placeholder-key
LLAMA_MODEL=meta-llama/llama-3-8b-instruct

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379/0

# Application Configuration
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000"]

# AWS Configuration (optional, for deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
